@page "/tags"
@using ExpenseDashboard.Domain.Reports
@using ExpenseDashboard.Web.Dashboard
@using ExpenseDashboard.Web.Tags
@inject TagService TagData
@inject DashboardService Dashboard

<PageTitle>標籤彙總</PageTitle>

<div class="page-header">
    <h1>標籤彙總</h1>
    @if (hasTags && options is { Years.Count: > 0 })
    {
        <select value="@year" @onchange="OnYearChanged" aria-label="年度">
            @foreach (var y in options.Years)
            {
                <option value="@y">@y 年</option>
            }
        </select>
        @if (options.Currencies.Count > 1)
        {
            <select value="@currency" @onchange="OnCurrencyChanged" aria-label="貨幣">
                @foreach (var c in options.Currencies)
                {
                    <option value="@c">@c</option>
                }
            </select>
        }
    }
</div>

@if (options is null)
{
    <p>載入中…</p>
}
else if (!hasTags)
{
    <section class="card empty-state">
        <p>目前匯入的紀錄都沒有標籤。</p>
        <p class="muted">
            在「天天記帳」幫紀錄加上標籤，重新匯出並<a href="import">匯入 CSV</a> 後，這裡就會依標籤列出每年、每月的花費。
            一筆紀錄可以有多個標籤（以逗號、頓號或分號分隔），會分別算進每個標籤。
            想依備註分類的話，可以用<a href="keywords">備註關鍵字</a>。
        </p>
    </section>
}
else if (report is not null)
{
    <p class="muted">
        @year 年支出 @report.TotalCount.ToString("N0") 筆，其中 @report.TaggedCount.ToString("N0") 筆有標籤。
        一筆有多個標籤時會分別計算，所以各標籤加總可能超過年度總額。點一列展開每月金額與明細。
    </p>

    @if (report.Tags.Count == 0)
    {
        <p class="muted">@year 年沒有帶標籤的 @currency 支出。</p>
    }
    else
    {
        <section class="card" aria-label="標籤列表">
            <table class="rule-table">
                <thead>
                    <tr><th>標籤</th><th>筆數</th><th>金額</th><th>占年度支出</th></tr>
                </thead>
                <tbody>
                    @foreach (var tag in report.Tags)
                    {
                        var expanded = string.Equals(expandedTag, tag.Name, StringComparison.OrdinalIgnoreCase);
                        <tr class="rule-row @(expanded ? "expanded" : null)" @onclick="() => ToggleAsync(tag.Name)">
                            <td>
                                <button type="button" class="rule-toggle" aria-expanded="@(expanded ? "true" : "false")"
                                        @onclick="() => ToggleAsync(tag.Name)" @onclick:stopPropagation>
                                    <span class="rule-caret" aria-hidden="true">@(expanded ? "▾" : "▸")</span>
                                    @tag.Name
                                </button>
                            </td>
                            <td class="num" data-label="筆數">@tag.Count.ToString("N0")</td>
                            <td class="num" data-label="金額">@FormatAmount(tag.Total)</td>
                            <td class="num" data-label="占年度支出">@Percent(tag.Share)</td>
                        </tr>
                        @if (expanded)
                        {
                            <tr class="rule-detail">
                                <td colspan="4">
                                    <div class="tag-months" aria-label="每月金額">
                                        @for (var m = 0; m < 12; m++)
                                        {
                                            <div class="tag-month">
                                                <span class="muted">@(m + 1) 月</span>
                                                <span>@(tag.Monthly[m] is decimal v ? v.ToString("#,0") : "—")</span>
                                            </div>
                                        }
                                    </div>
                                    @if (expenses is null)
                                    {
                                        <p class="muted">載入中…</p>
                                    }
                                    else
                                    {
                                        <table class="match-table">
                                            <thead>
                                                <tr><th>日期</th><th>金額</th><th>類別</th><th>備註／標籤</th></tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var e in expenses.Take(DetailLimit))
                                                {
                                                    <tr>
                                                        <td>@e.Date.ToString("yyyy/MM/dd")</td>
                                                        <td class="num">@e.Amount.ToString("#,0.##") @e.Currency</td>
                                                        <td>@e.Category</td>
                                                        <td>@e.Note <span class="muted">［@e.Tags］</span></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        @if (expenses.Count > DetailLimit)
                                        {
                                            <p class="muted table-note">只顯示最近 @DetailLimit 筆，還有 @(expenses.Count - DetailLimit) 筆。</p>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </section>
    }
}

@code {
    private const int DetailLimit = 200;

    private DashboardOptions? options;
    private bool hasTags;
    private int year;
    private string currency = DashboardService.DefaultCurrency;
    private TagReport? report;
    private string? expandedTag;
    private IReadOnlyList<TaggedExpense>? expenses;

    protected override async Task OnInitializedAsync()
    {
        options = await Dashboard.GetOptionsAsync();
        hasTags = options.Years.Count > 0 && await TagData.AnyTaggedAsync();
        if (!hasTags)
        {
            return;
        }

        year = options.Years[0];
        if (!options.Currencies.Contains(currency))
        {
            currency = options.Currencies[0];
        }
        await LoadAsync();
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var y))
        {
            year = y;
            await LoadAsync();
        }
    }

    private async Task OnCurrencyChanged(ChangeEventArgs e)
    {
        currency = e.Value?.ToString() ?? DashboardService.DefaultCurrency;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        expandedTag = null;
        expenses = null;
        report = await TagData.GetReportAsync(year, currency);
    }

    private async Task ToggleAsync(string tag)
    {
        if (string.Equals(expandedTag, tag, StringComparison.OrdinalIgnoreCase))
        {
            expandedTag = null;
            expenses = null;
            return;
        }

        expandedTag = tag;
        expenses = null;
        expenses = await TagData.GetExpensesAsync(tag, year, currency);
    }

    private string FormatAmount(decimal amount) => $"{amount:#,0} {currency}";

    // 不用 "P0"：伺服器文化設定會在數字和 % 之間插空白。
    private static string Percent(decimal ratio) => $"{ratio * 100:0.0}%";
}
