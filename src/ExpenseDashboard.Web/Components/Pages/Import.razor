@page "/import"
@using System.Text
@using ExpenseDashboard.Domain.Import
@using ExpenseDashboard.Domain.Transactions
@using ExpenseDashboard.Web.Import
@inject TransactionImporter Importer
@inject ILogger<Import> Logger

<PageTitle>匯入 CSV</PageTitle>

<div class="page-header">
    <h1>匯入 CSV</h1>
</div>

<p>選擇「天天記帳」匯出的 CSV 檔。重複匯入同一份檔案不會產生重複資料；在 App 修改過的紀錄會自動更新。</p>

<label class="sync-option">
    <input type="checkbox" @bind="syncDeletes" disabled="@isImporting" />
    同步刪除：找出匯出檔日期範圍內、但檔案中已經沒有的紀錄（在 App 裡刪掉的），確認後再刪除
</label>

<InputFile OnChange="OnFileSelected" accept=".csv,text/csv" disabled="@isImporting" />

@if (isImporting)
{
    <p>匯入中…</p>
}

@if (failure is not null)
{
    <p class="import-failure">@failure</p>
}

@if (summary is not null)
{
    <p class="import-summary">
        @fileName：新增 @summary.Added 筆、更新 @summary.Updated 筆、未變更 @summary.Unchanged 筆。
    </p>
}

@if (syncNotice is not null)
{
    <p class="muted">@syncNotice</p>
}

@if (missing is { Count: > 0 })
{
    <section class="card delete-preview" aria-label="待刪除紀錄">
        <h2>以下 @missing.Count 筆在 @rangeText 之間，但匯出檔中已經沒有</h2>
        <p class="muted">通常是在 App 裡刪掉的紀錄。按「確定刪除」才會從儀表板的資料庫刪除。</p>
        <table class="rule-table">
            <thead>
                <tr><th>日期</th><th>類別</th><th>金額</th><th>備註</th></tr>
            </thead>
            <tbody>
                @foreach (var t in missing.Take(PreviewLimit))
                {
                    <tr>
                        <td>@t.Date.ToString("yyyy/MM/dd")</td>
                        <td>@t.Category</td>
                        <td class="num" data-label="金額">@t.Amount.ToString("#,0.##") @t.Currency</td>
                        <td>@t.Note</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (missing.Count > PreviewLimit)
        {
            <p class="muted table-note">…還有 @(missing.Count - PreviewLimit) 筆。</p>
        }
        <div class="form-actions">
            <button type="button" class="btn-danger" @onclick="ConfirmDeleteAsync" disabled="@isImporting">確定刪除 @missing.Count 筆</button>
            <button type="button" @onclick="CancelDelete" disabled="@isImporting">不要刪除</button>
        </div>
    </section>
}

@if (errors.Count > 0)
{
    <p class="import-failure">
        @(summary is null ? "無法匯入：" : $"以下 {errors.Count} 列無法匯入，已略過：")
    </p>
    <ul>
        @foreach (var error in errors)
        {
            <li>第 @error.LineNumber 行：@error.Message</li>
        }
    </ul>
}

@code {
    private const long MaxFileSize = 20 * 1024 * 1024;
    private const int PreviewLimit = 100;

    private bool isImporting;
    private string? fileName;
    private string? failure;
    private ImportSummary? summary;
    private IReadOnlyList<CsvImportError> errors = [];
    private bool syncDeletes;
    private IReadOnlyList<Transaction>? missing;
    private string? rangeText;
    private string? syncNotice;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        isImporting = true;
        fileName = e.File.Name;
        failure = null;
        summary = null;
        errors = [];
        missing = null;
        syncNotice = null;

        try
        {
            if (e.File.Size > MaxFileSize)
            {
                failure = $"檔案太大（上限 {MaxFileSize / 1024 / 1024} MB）。";
                return;
            }

            // Blazor Server 的檔案串流只能非同步讀取，先整份複製到記憶體再解析。
            using var buffer = new MemoryStream();
            await using (var upload = e.File.OpenReadStream(MaxFileSize))
            {
                await upload.CopyToAsync(buffer);
            }
            buffer.Position = 0;

            using var reader = new StreamReader(buffer, Encoding.UTF8, detectEncodingFromByteOrderMarks: true);
            var result = DailyExpenseCsvParser.Parse(reader);
            errors = result.Errors;

            if (result.Transactions.Count > 0)
            {
                summary = await Importer.ImportAsync(result.Transactions);
                if (syncDeletes)
                {
                    await PreviewMissingAsync(result);
                }
            }
            else if (errors.Count == 0)
            {
                failure = "檔案中沒有任何資料列。";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to import {FileName}", fileName);
            failure = "匯入失敗，請確認檔案是「天天記帳」匯出的 CSV。";
        }
        finally
        {
            isImporting = false;
        }
    }

    private async Task PreviewMissingAsync(CsvParseResult result)
    {
        // 解析失敗的列不知道 UUID，會被誤判成「已刪除」，所以這種情況不做刪除檢查。
        if (result.Errors.Count > 0)
        {
            syncNotice = "檔案中有無法解析的列，為避免誤刪，這次沒有檢查要刪除的紀錄。";
            return;
        }

        var from = result.Transactions.Min(t => t.Date);
        var to = result.Transactions.Max(t => t.Date);
        rangeText = $"{from:yyyy/MM/dd}–{to:yyyy/MM/dd}";
        missing = await Importer.FindMissingAsync(result.Transactions);
        if (missing.Count == 0)
        {
            syncNotice = $"{rangeText} 之間沒有需要刪除的紀錄。";
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (missing is null)
        {
            return;
        }

        isImporting = true;
        try
        {
            var deleted = await Importer.DeleteAsync(missing.Select(t => t.Id).ToList());
            syncNotice = $"已刪除 {deleted} 筆。";
            missing = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete missing transactions");
            failure = "刪除失敗，資料沒有變更。";
        }
        finally
        {
            isImporting = false;
        }
    }

    private void CancelDelete()
    {
        syncNotice = $"沒有刪除任何紀錄（{missing?.Count ?? 0} 筆保留）。";
        missing = null;
    }
}
