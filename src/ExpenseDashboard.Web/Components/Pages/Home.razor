@page "/"
@using ExpenseDashboard.Domain.Reports
@using ExpenseDashboard.Web.Dashboard
@inject DashboardService Dashboard

<PageTitle>記帳儀表板</PageTitle>

<h1>記帳儀表板</h1>

@if (options is null)
{
    <p>載入中…</p>
}
else if (options.Years.Count == 0)
{
    <p>尚無資料，請先<a href="import">匯入「天天記帳」CSV</a>。</p>
}
else
{
    <div class="filters">
        <label>
            期間
            <select value="@(year?.ToString() ?? "")" @onchange="OnYearChanged">
                @foreach (var y in options.Years)
                {
                    <option value="@y">@y 年</option>
                }
                <option value="">全部期間</option>
            </select>
        </label>
        @if (options.Currencies.Count > 1)
        {
            <label>
                貨幣
                <select value="@currency" @onchange="OnCurrencyChanged">
                    @foreach (var c in options.Currencies)
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </label>
        }
    </div>

    @if (data is not null)
    {
        <section class="stat-tiles" aria-label="期間摘要">
            <div class="stat-tile">
                <span class="stat-label">收入</span>
                <span class="stat-value">@FormatAmount(data.Summary.Income)</span>
            </div>
            <div class="stat-tile">
                <span class="stat-label">支出</span>
                <span class="stat-value">@FormatAmount(data.Summary.Expense)</span>
            </div>
            <div class="stat-tile">
                <span class="stat-label">結餘</span>
                <span class="stat-value">@FormatAmount(data.Summary.Net)</span>
            </div>
            <div class="stat-tile">
                <span class="stat-label">筆數</span>
                <span class="stat-value">@data.Summary.Count.ToString("N0")</span>
            </div>
        </section>

        @if (data.Summary.Count == 0)
        {
            <p>這段期間沒有 @currency 的紀錄。</p>
        }
        else
        {
            <section class="chart-card" @key="@($"monthly-{FilterKey}")">
                <h2>每月收支</h2>
                <ApexChart TItem="MonthlyTotal" Options="monthlyOptions" Height="320">
                    <ApexPointSeries TItem="MonthlyTotal" Items="data.Monthly" Name="收入" SeriesType="SeriesType.Bar"
                                     XValue="@(m => m.Label)" YValue="@(m => m.Income)" />
                    <ApexPointSeries TItem="MonthlyTotal" Items="data.Monthly" Name="支出" SeriesType="SeriesType.Bar"
                                     XValue="@(m => m.Label)" YValue="@(m => m.Expense)" />
                </ApexChart>
                <details>
                    <summary>以表格檢視</summary>
                    <table class="data-table">
                        <thead>
                            <tr><th>月份</th><th>收入</th><th>支出</th><th>結餘</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var m in data.Monthly)
                            {
                                <tr>
                                    <td>@m.Label</td>
                                    <td>@FormatAmount(m.Income)</td>
                                    <td>@FormatAmount(m.Expense)</td>
                                    <td>@FormatAmount(m.Net)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </details>
            </section>

            @if (data.ByMajorCategory.Count > 0)
            {
                <div class="chart-grid">
                    <section class="chart-card" @key="@($"major-{FilterKey}")">
                        <h2>支出：依大類別</h2>
                        <ApexChart TItem="CategoryTotal" Options="majorCategoryOptions" Height="@CategoryChartHeight(data.ByMajorCategory)">
                            <ApexPointSeries TItem="CategoryTotal" Items="data.ByMajorCategory" Name="支出" SeriesType="SeriesType.Bar"
                                             XValue="@(c => c.Name)" YValue="@(c => c.Amount)" />
                        </ApexChart>
                        <CategoryTable Items="data.ByMajorCategory" NameHeader="大類別" />
                    </section>

                    <section class="chart-card" @key="@($"top-{FilterKey}")">
                        <h2>支出前 @data.TopCategories.Count 名類別</h2>
                        <ApexChart TItem="CategoryTotal" Options="topCategoryOptions" Height="@CategoryChartHeight(data.TopCategories)">
                            <ApexPointSeries TItem="CategoryTotal" Items="data.TopCategories" Name="支出" SeriesType="SeriesType.Bar"
                                             XValue="@(c => c.Name)" YValue="@(c => c.Amount)" />
                        </ApexChart>
                        <CategoryTable Items="data.TopCategories" NameHeader="類別" />
                    </section>
                </div>
            }
        }
    }
}

@code {
    // 參考色盤（dataviz）：分類色依固定順序指派，收入 = slot 1 藍、支出 = slot 2 橘。
    private const string IncomeColor = "#2a78d6";
    private const string ExpenseColor = "#eb6834";
    private const string SurfaceColor = "#fcfcfb";
    private const string AmountFormatter = "function (value) { return Number(value).toLocaleString('zh-TW', { maximumFractionDigits: 2 }); }";
    // 軸刻度用精簡寫法（例如 30萬），避免窄螢幕上互相重疊；tooltip 仍顯示完整金額。
    private const string AxisFormatter = "function (value) { return Number(value).toLocaleString('zh-TW', { notation: 'compact', maximumFractionDigits: 1 }); }";

    private DashboardOptions? options;
    private DashboardData? data;
    private int? year;
    private string currency = DashboardService.DefaultCurrency;

    private readonly ApexChartOptions<MonthlyTotal> monthlyOptions = CreateOptions<MonthlyTotal>([IncomeColor, ExpenseColor], horizontal: false);
    // 每張圖都要有自己的 options 實例：ApexChart 會把自身的 chart id 寫進 options，共用會讓其中一張不顯示。
    private readonly ApexChartOptions<CategoryTotal> majorCategoryOptions = CreateOptions<CategoryTotal>([ExpenseColor], horizontal: true);
    private readonly ApexChartOptions<CategoryTotal> topCategoryOptions = CreateOptions<CategoryTotal>([ExpenseColor], horizontal: true);

    private string FilterKey => $"{year}-{currency}";

    protected override async Task OnInitializedAsync()
    {
        options = await Dashboard.GetOptionsAsync();
        if (options.Years.Count == 0)
        {
            return;
        }

        year = options.Years[0];
        if (!options.Currencies.Contains(currency))
        {
            currency = options.Currencies[0];
        }
        await LoadAsync();
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        year = int.TryParse(e.Value?.ToString(), out var y) ? y : null;
        await LoadAsync();
    }

    private async Task OnCurrencyChanged(ChangeEventArgs e)
    {
        currency = e.Value?.ToString() ?? DashboardService.DefaultCurrency;
        await LoadAsync();
    }

    private async Task LoadAsync() => data = await Dashboard.LoadAsync(new DashboardFilter(year, currency));

    private string FormatAmount(decimal amount) => $"{amount:#,0.##} {currency}";

    private static int CategoryChartHeight(IReadOnlyList<CategoryTotal> items) => 60 + 32 * Math.Max(items.Count, 3);

    private static ApexChartOptions<T> CreateOptions<T>(List<string> colors, bool horizontal) where T : class => new()
    {
        Chart = new Chart
        {
            Toolbar = new Toolbar { Show = false },
            Zoom = new Zoom { Enabled = false },
            FontFamily = "inherit",
        },
        Colors = colors,
        DataLabels = new DataLabels { Enabled = false },
        PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar
            {
                Horizontal = horizontal,
                BorderRadius = 4,
                BorderRadiusApplication = BorderRadiusApplication.End,
                ColumnWidth = "60%",
                BarHeight = "60%",
            },
        },
        // 相鄰長條之間留 2px 表面色間隙。
        Stroke = new Stroke { Show = true, Width = 2, Colors = [SurfaceColor] },
        Grid = new Grid { BorderColor = "#e7e6e2", StrokeDashArray = 0 },
        Legend = new Legend { Show = !horizontal, Position = LegendPosition.Top, HorizontalAlign = Align.Left },
        Xaxis = horizontal ? new XAxis { Labels = new XAxisLabels { Formatter = AxisFormatter } } : null,
        Yaxis = horizontal ? null : [new YAxis { Labels = new YAxisLabels { Formatter = AxisFormatter } }],
        Tooltip = new Tooltip { Y = new TooltipY { Formatter = AmountFormatter } },
        // 窄螢幕上長條本身只有幾 px，2px 間隙會把它吃掉，改用較寬的長條並拿掉間隙。
        Responsive =
        [
            new Responsive<T>
            {
                Breakpoint = 640,
                Options = new ApexChartOptions<T>
                {
                    Stroke = new Stroke { Show = false, Width = 0 },
                    PlotOptions = new PlotOptions
                    {
                        Bar = new PlotOptionsBar
                        {
                            Horizontal = horizontal,
                            BorderRadius = 2,
                            BorderRadiusApplication = BorderRadiusApplication.End,
                            ColumnWidth = "85%",
                            BarHeight = "60%",
                        },
                    },
                },
            },
        ],
    };
}
